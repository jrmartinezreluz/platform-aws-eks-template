# Copy and set namespace/selectors/ports. Do not apply this example as-is.
# Pattern: specific source → specific destination → specific port.
---
# PostgreSQL 5432
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: 50-allow-postgres
spec:
  podSelector:
    matchLabels:
      app: REPLACE
  policyTypes: [Egress]
  egress:
    - to:
        - ipBlock:
            cidr: 10.0.0.0/32
      ports:
        - protocol: TCP
          port: 5432
---
# MySQL/MariaDB 3306
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: 50-allow-mysql
spec:
  podSelector:
    matchLabels:
      app: REPLACE
  policyTypes: [Egress]
  egress:
    - to:
        - ipBlock:
            cidr: 10.0.0.0/32
      ports:
        - protocol: TCP
          port: 3306
---
