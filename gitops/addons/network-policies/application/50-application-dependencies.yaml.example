# OpenSearch 443/9200
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: 50-allow-opensearch
spec:
  podSelector:
    matchLabels:
      app: REPLACE
  policyTypes: [Egress]
  egress:
    - to:
        - ipBlock:
            cidr: 10.0.0.0/32
      ports:
        - protocol: TCP
          port: 443
        - protocol: TCP
          port: 9200
